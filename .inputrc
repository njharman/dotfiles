# Readline configuration.
#
# Readline reads this file once, at shell startup. On Omarchy that is not the
# last word: $OMARCHY_PATH/default/bash/rc then runs `bind -f` on its own inputrc,
# overriding anything both files set -- including dropping us out of vi mode.
# .bashrc_base re-applies this file at the end of startup to fix that.
#
# Because of that re-apply, settings Omarchy makes that are NOT named here are
# inherited rather than reset: TAB: menu-complete, menu-complete-backward,
# menu-complete-display-prefix, completion-query-items, page-completions off.
# Anything below deliberately overrides Omarchy or fills a gap it leaves.

$include /etc/inputrc


## 1. Editing mode
set editing-mode vi

$if mode=vi
  # Show whether we're in insert or command mode directly in the prompt.
  set show-mode-in-prompt on
  # Terminal cursor shape per mode: bar in insert, block in command.
  set vi-ins-mode-string "\1\e[6 q\2"
  set vi-cmd-mode-string "\1\e[2 q\2"

  set keymap vi-command
  # Prefix history search. Matches vim: k goes up (older), j goes down (newer).
  "k": history-search-backward
  "j": history-search-forward
  "gg": beginning-of-history
  "G": end-of-history

  set keymap vi-insert
  # Prefix history search on the arrow keys. Omarchy binds these too, but only in
  # the emacs keymap, so vi-insert needs its own.
  "\e[A": history-search-backward
  "\e[B": history-search-forward
  "\e[C": forward-char
  "\e[D": backward-char
  # kk to command mode.
  "kk": vi-movement-mode
$endif


## 2. History search
# Same prefix search as the arrows, on keys that work in either editing mode.
"\C-p": history-search-backward
"\C-n": history-search-forward


## 3. Completion
# Omarchy turns this on; we want case to matter.
set completion-ignore-case off
# Minimum length of the common prefix before it is replaced by "..." in the
# completion list. Keeps long shared paths from crowding out the differences.
set completion-prefix-display-length 3


## 4. Other keys
# Expand globs in place without executing. Eg 'rm *x'.
"\C-g": glob-expand-word

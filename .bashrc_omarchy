# Omarchy-specific interactive bash config. Sourced by ~/.bashrc_base.
#
# Deliberately near-empty. Omarchy's own $OMARCHY_PATH/default/bash/rc already
# provides the things the Ubuntu layer has to set up by hand:
#
#   prompt          starship
#   cd              zoxide (aliased to zd; tries CDPATH from .bashrc_base first,
#                   then fuzzy-matches visited dirs. Never completes `cd` TAB.)
#   ls / lt         eza, with icons and a tree view
#   MANPAGER        bat
#   completion      /usr/share/bash-completion + fzf key bindings
#   PATH            ~/.local/bin
#
# .bashrc_base overrides what it needs from those. Put anything genuinely
# Omarchy-only here.

# Restore traditional ls behavior (names only, colorized/icons, grid layout)
# instead of Omarchy's default long-format `eza -lh ...`.
if command -v eza &> /dev/null; then
  alias ls='eza --group-directories-first --icons=auto'
fi

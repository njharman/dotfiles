# The single global git config.
#
# Git reads BOTH ~/.config/git/config and ~/.gitconfig as "global", in that
# order, with this file winning any key set in both. Omarchy ships its own
# ~/.config/git/config, which meant two files silently disagreeing (its
# init.defaultBranch=master vs. trunk here, its pull.rebase vs. pull.ff here).
# engage.sh backs that file up and removes it, so this is the only one.
#
# Global ignore patterns live in ~/.config/git/ignore -- git's default
# core.excludesFile, so it needs no setting here.

[user]
  name = Norman J. Harman Jr.
  email = njharman@gmail.com

[core]
  filemode = true
  autocrlf = false
  editor = vim
  # Don't wrap long lines in the pager; scroll sideways with arrow keys instead.
  # -S composes with the LESS=FRX git exports when LESS is unset (it is).
  pager = less -S
[apply]
  whitespace=warn
[branch]
  autosetupmerge = true
  sort = -committerdate
[column]
  ui = auto
[commit]
  verbose = true
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
[fetch]
  prune = true
  fsckobjects = true
[init]
  defaultBranch = trunk
  templateDir = ~/.git-template
[pull]
  ff = only
[push]
  default = simple
  autoSetupRemote = true
[receive]
  fsckobjects = true
[rerere]
  enabled = true
  autoupdate = true
[tag]
  sort = -version:refname
[transfer]
  fsckobjects = true

[alias]
  # git log --no-merges trunk
  # See only the file names that has changed in current branch
  # git diff --no-commit-id --name-only --no-merges origin/trunk
  # Similar to above, but see statistics on what files have changed and how
  # git diff --stat #Your diff condition
  br = branch -a
  ci = commit --verbose
  co = checkout
  dh = diff HEAD
  ds = diff --staged
  dq = diff --stat --compact-summary
  rl = reflog
  st = status --short
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold red)%h%C(reset) %s %C(green)(%ar)%C(reset) %C(bold blue)<%an>%C(reset)%C(auto)%d%C(reset)'
  alg = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold red)%h%C(reset) %s %C(green)(%ar)%C(reset) %C(bold blue)<%an>%C(reset)%C(auto)%d%C(reset)'
  llg = log --graph --abbrev-commit --decorate --name-status --format=format:'%C(bold red)%h%C(reset) %s %C(green)(%ar)%C(reset) %C(bold blue)<%an>%C(reset)%C(auto)%d%C(reset)%n%+b'
  ignored = ls-files -o -i --exclude-standard
  oldbranch = for-each-ref --sort=-authorname --format='%(refname) %(authorname) %(committerdate)' refs/remotes/origin/
  stats = shortlog -sn --since='10 weeks' --until='2 weeks'

[color]
  ui = auto
[color "branch"]
  current = green reverse
  local = green
  remote = green
[color "diff"]
  meta = blue dim
  frag = magenta bold
  old = red bold
  new = green
[color "status"]
  added = green
  changed = red
  untracked = cyan

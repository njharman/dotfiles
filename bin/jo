#!/bin/bash
# Create tmux "workspaces"

# So I don't hafta google how to do this again.
# while getopts "b" option; do
#   case $option in
#     b) build_host='true';;
#   esac
# done
# shift $((OPTIND-1))


if [[ "$2" == "" ]]; then
  session="amadeus"  # Default 'rockme' session.
else
  session="$1"
  shift
fi

if [[ "$1" == "" ]]; then
  echo Read the source.
  exit
else
  target="$1"
fi


if [[ "$target" == "help" ]]; then
  echo "  jo ud<foo> generic 3 way"
  echo "  jo cna"
  echo "  jo knog"
  echo -e "  jo <proj>  proj is vbox and dirname of python project\nProjects:"
  vex --list
elif [[ "${target:0:2}" == "ud" ]]; then
  ## 3way generic. Each ud must be unique.
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 40
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u select-pane -t "$session:$target".1
elif [[ "${target:0:3}" == "rev" ]]; then
  project="rev-engine"
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 40
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u send-keys -t "$session:$target".1 "cd ~/work/news/${project}/;poetry shell" C-m
  tmux -u send-keys -t "$session:$target".2 "cd ~/work/news/${project}/;poetry shell" C-m
  tmux -u send-keys -t "$session:$target".3 "cd ~/work/news/${project}/;poetry shell" C-m
  sleep 2
  tmux -u send-keys -t "$session:$target".1 "nvm use 18" C-m
  tmux -u send-keys -t "$session:$target".2 "nvm use 18;git status" C-m
  tmux -u send-keys -t "$session:$target".3 "nvm use 18" C-m
  tmux -u select-pane -t "$session:$target".1
elif [[ "${target:0:3}" == "swb" ]]; then
  project="switchboard-api"
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 40
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u send-keys -t "$session:$target".1 "cd ~/work/news/${project}/;poetry shell" C-m
  tmux -u send-keys -t "$session:$target".2 "cd ~/work/news/${project}/;poetry shell" C-m
  tmux -u send-keys -t "$session:$target".3 "cd ~/work/news/${project}/;poetry shell" C-m
  tmux -u select-pane -t "$session:$target".1
  sleep 1
  tmux -u send-keys -t "$session:$target".2 "git status" C-m
  tmux -u send-keys -t "$session:$target".3 "pytest" C-m
elif [[ "$target" == "cna" ]]; then
  vex="cnaapi"
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 40
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u split-window -t "$session:$target".3 -h
  tmux -u send-keys -t "$session:$target".1 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".1 "cd ~/Dropbox/code/cna/api;./manage.py runserver 127.0.0.1:8100" C-m
  tmux -u send-keys -t "$session:$target".2 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".2 "cd ~/Dropbox/code/cna/web;python -m http.server 8000" C-m
  tmux -u send-keys -t "$session:$target".3 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".3 "cd ~/Dropbox/code/cna/core;clear;ls" C-m
  tmux -u send-keys -t "$session:$target".4 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".4 "cd ~/Dropbox/code/cna/api;clear;ls" C-m
  tmux -u select-pane -t "$session:$target".1
elif [[ "$target" == "knog" ]]; then
  ## 3-way SSH to target.
  # work pane left
  tmux -u new-window -n "$target" "ssh $target"
  # wide log below
  tmux -u split-window -t "$session:$target".1 -dv -l 20 "ssh $target"
  sleep .5
  tmux -u send-keys -t "$session:$target".2 'who' C-m
  tmux -u send-keys -t "$session:$target".2 'uptime' C-m
  # tmux -u send-keys -t "$session:$target".2 'clear;cd /var/log;echo "tailing some logs";sudo tail --follow=name messages syslog kern.log' C-m
  # root shell right
  tmux -u split-window -t "$session:$target".1 -dh -p 50 "ssh $target"
  sleep .5
  tmux -u send-keys -t "$session:$target".2 'sudo bash' C-m
else
  # 4way dev
  path="$target"
  vex="$target"
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 40
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u split-window -t "$session:$target".3 -h
  tmux -u send-keys -t "$session:$target".1 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".1 "cd ~/Dropbox/code/$path;clear;ls" C-m
  tmux -u send-keys -t "$session:$target".2 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".2 "cd ~/Dropbox/code/$path;clear" C-m
  tmux -u send-keys -t "$session:$target".3 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".3 "cd ~/Dropbox/code/$path;nukepyc;clear;tree" C-m
  tmux -u send-keys -t "$session:$target".4 "vex $vex" C-m
  tmux -u send-keys -t "$session:$target".4 "cd ~/Dropbox/code/$path;clear" C-m
  tmux -u select-pane -t "$session:$target".1
fi

#!/bin/bash
# Create tmux "workspaces"

# So I don't hafta google how to do this again.
# while getopts "b" option; do
#   case $option in
#     b) build_host='true';;
#   esac
# done
# shift $((OPTIND-1))


if [[ "$2" == "" ]]; then
  session="amadeus"  # Default 'rockme' session.
else
  session="$1"
  shift
fi

if [[ "$1" == "" ]]; then
  echo Read the source.
  exit
else
  target="$1"
fi


if [[ "${target:0:2}" == "ud" ]]; then
  ## 3way generic Ubuntu Desktop. Each ud must be unique.
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 30
  tmux -u split-window -t "$session:$target".1 -h
  tmux -u select-pane -t "$session:$target".1
elif [[ "$target" == "knog" ]]; then
  ## 3-way SSH to target.
  # work pane left
  tmux -u new-window -n "$target" "ssh $target"
  # wide log below
  tmux -u split-window -t "$session:$target".1 -dv -l 20 "ssh $target"
  sleep .5
  tmux -u send-keys -t "$session:$target".2 'who' C-m
  tmux -u send-keys -t "$session:$target".2 'uptime' C-m
  # tmux -u send-keys -t "$session:$target".2 'clear;cd /var/log;echo "tailing some logs";sudo tail --follow=name messages syslog kern.log' C-m
  # root shell right
  tmux -u split-window -t "$session:$target".1 -dh -p 50 "ssh $target"
  sleep .5
  tmux -u send-keys -t "$session:$target".2 'sudo bash' C-m
else
  # 4way dev
  project="$target"
  tmux -u new-window -n "$target"
  tmux -u split-window -t "$session:$target".1 -v -l 30
  tmux -u split-window -t "$session:$target".1 -h
#  tmux -u split-window -t "$session:$target".3 -h
  tmux -u send-keys -t "$session:$target".1 "vex $project" C-m
  tmux -u send-keys -t "$session:$target".1 "cd ~/Dropbox/code/$project;clear" C-m
  tmux -u send-keys -t "$session:$target".2 "vex $project" C-m
  tmux -u send-keys -t "$session:$target".2 "cd ~/Dropbox/code/$project;clear" C-m
  tmux -u send-keys -t "$session:$target".3 "vex $project" C-m
  tmux -u send-keys -t "$session:$target".3 "cd ~/Dropbox/code/$project;clear" C-m
  tmux -u send-keys -t "$session:$target".4 "cd ~/Dropbox/code/$project;clear;ls" C-m
  tmux -u select-pane -t "$session:$target".1
fi

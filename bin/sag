#!/bin/bash
#
# sag - rg search with numbered shortcuts to open files at the right line in the editor.
# Companion: g <number> (generated into $sag__shortcut_path/$sag__shortcut_cmd)

# Script Functions

print_current_profile_info() {
    echo ""
    echo "===> Current Profile: $sag__profile_name"
    echo "===> Using flags: $sag__profile_preset_flags"
    echo "===> Searching under: $sag__profile_preset_directory"
}

print_help() {
    sp="   " # space
    echo ""
    echo "===============> sag Usage Information <==============="
    echo ""
    echo "===> To print this message: <==="
    echo "$sp sag"
    echo "$sp sag -h"
    echo "$sp sag --help"
    echo "$sp sag --info"
    echo ""
    echo "========> sag-specific commands <========"
    echo ""
    echo "===> Which Profile? <==="
    echo "To find out which profile you are currently on:"
    echo "$sp sag -wp"
    echo "$sp sag --whichprofile"
    echo ""
    echo "===> Switch Profile <==="
    echo "To switch to a different profile:"
    echo "$sp sag -sp PROFILE_NAME"
    echo "$sp sag --switchprofile no_profile"
    echo ""
    echo "===> Rename Profile <==="
    echo "To rename the current profile:"
    echo "$sp sag -rp NEW_PROFILE_NAME"
    echo "$sp sag --renameprofile reviewboard"
    echo ""
    echo "===> Set Flags <==="
    echo "To set new preset flags to use for the current profile:"
    echo "(All searches run using this profile will use these flags)"
    echo "$sp sag -sf NEW_FLAGS"
    echo "$sp sag --setflags -ia -A 2 -B 3"
    echo ""
    echo "===> Set Directory <==="
    echo "To set a new preset directory to use for the current profile:"
    echo "(All searches will be run under this directory with this profile)"
    echo "$sp sag -sd NEW_DIRECTORY"
    echo "$sp sag --setdirectory ~/src/reviewboard"
    echo ""
    echo "===> Add New Profile <==="
    echo "To add a new empty profile:"
    echo "$sp sag -anp PROFILE_NAME"
    echo "$sp sag --addnewprofile ReviewBoard"
    echo ""
    echo "===> List Profiles <==="
    echo "To show the current available profiles:"
    echo "$sp sag -lp"
    echo "$sp sag --listprofiles"
    print_current_profile_info
}

# Prefixes a shortcut number to each rg --nogroup -H output line, grouped by file.
display_shortcuts() {
    awk -v f_name=$sag__file_name -F':' '
    BEGIN {x=1};
    {
        if ($1 != f_name) {
            printf("\n%s\n", $1);
            f_name=$1;
        };
        printf("[%s] ", x);
        printf("%s", $2);
        for (i=3; i<=NF; i++) {
            printf(":%s", $i);
        }
        printf("\n");
        x++;
    };'
}

# Format: line_number:full_file_path
process_shorcut_paths() {
    awk -F':' '
    {
        print $2 " " $1;
    };'
}

# Strips the color escape codes so the shortcut file stays plain text
remove_escaped_chars() {
    sag__esc=$'\x1b'
    if [[ $sag__OS == "Linux" ]] || [[ $sag__OS == "$CYGWIN_NT"* ]]; then
        sed -r "s/${sag__esc}\[([0-9]{1,2}(;[0-9]{1,2})?)?[m|K]//g"
    elif [[ $sag__OS == "Darwin" ]]; then
        sed -E "s/${sag__esc}\[([0-9]{1,2}(;[0-9]{1,2})?)?[m|K]//g"
    fi
}

# Writes the g shortcut command, executable, resolving vim/gvim/$EDITOR at run time
create_shortcut_cmd_vim() {
    sag__shortcut_cmd_path=$sag__shortcut_path/$sag__shortcut_cmd
    cat > $sag__shortcut_cmd_path <<SHORTCUT
#!/bin/bash
sag__vim_shortcut=\$(sed -n "\$1p" < $sag__shortcut_file)
sag__line=\`echo \$sag__vim_shortcut | cut -d" " -f1\`
sag__file=\`echo \$sag__vim_shortcut | sed 's/'\$sag__line' //'\`
if [ -z "\$EDITOR" ]; then
    sag__editor="$sag__default_editor"
else
    sag__editor="\$EDITOR"
fi
\$sag__editor +\$sag__line "\$sag__file"
SHORTCUT
    chmod +x $sag__shortcut_cmd_path
}

switchprofile() {
    sag__selected_profile=$1

    if [[ "$sag__selected_profile" == "" ]]; then
      sag__selected_profile=no_profile
    fi

    # If there are multiple exact-name matches (e.g. current profile == target),
    # use only the first one
    sag__switch_to_profile_raw=$(cat $sag__config_path | grep --line-regexp -A 2 "sag__profile_name=$sag__selected_profile" | head -3)

    if [[ -z $sag__switch_to_profile_raw ]]; then
        echo ""
        echo "===> Error: profile \"$sag__selected_profile\" is not found"
        echo ""
        echo "To create a new profile, do:"
        echo "    sag -anp PROFILE_NAME"
        echo "    sag --addnewprofile ReviewBoard"
        return 1
    fi

    sag__new_profile_preset_flags=$(echo "$sag__switch_to_profile_raw" | grep "sag__profile_preset_flags" | sed -e "s/sag__profile_preset_flags=//")
    sag__new_profile_preset_directory=$(echo "$sag__switch_to_profile_raw" | grep "sag__profile_preset_directory" | sed -e "s/sag__profile_preset_directory=//")

    # Rewritten via a temp file + swap to avoid partial writes to the config
    cat $sag__config_path | awk -v new_profile_name="$sag__selected_profile" -v new_profile_preset_flags="$sag__new_profile_preset_flags" -v new_profile_preset_directory="$sag__new_profile_preset_directory" 'BEGIN {in_cur_profile_block=0};
        {
            if ( in_cur_profile_block==0 ) {
                print $0;
            }

            if ( $2=="sag__beacon_tag_current_profile" ) {
                if ( $3=="BEGIN" ) {
                    in_cur_profile_block=1;
                    print "#"
                    print "sag__profile_name=" new_profile_name;
                    print "sag__profile_preset_flags=" new_profile_preset_flags;
                    print "sag__profile_preset_directory=" new_profile_preset_directory;
                } else if ( $3=="END" ) {
                    in_cur_profile_block=0;
                    print "#"
                    print $0
                }
            }
        };' > $sag__config_path.tmp
    rm $sag__config_path
    mv $sag__config_path.tmp $sag__config_path

    echo ""
    echo "===> sag: switched profile <==="
    echo "Now using profile: $sag__selected_profile"
    echo "Profile preset flags: $sag__new_profile_preset_flags"
    echo "Profile preset directory: $sag__new_profile_preset_directory"
}

renameprofile() {
    sag__new_profile_name=$1
    if [[ -z "$sag__new_profile_name" ]]; then
        echo ""
        echo "===> Must specify a new profile name!"
        return 1
    elif [[ "$sag__new_profile_name" == "no_profile" ]]; then
        echo ""
        echo "===> Must not rename current profile to \"no_profile\"!"
        return 1
    fi

    sag__current_profile_raw=$(cat $sag__config_path | grep -A 3 "# sag__beacon_tag_current_profile BEGIN")
    sag__profile_name=$(echo "$sag__current_profile_raw" | grep "sag__profile_name=" | sed -e "s/sag__profile_name=//")

    if [[ "$sag__profile_name" == "no_profile" ]]; then
        echo ""
        echo "===> Renaming for \"no_profile\" is disallowed!"
        return 1
    fi

    cat $sag__config_path | awk -v replace_flag="sag__profile_name=$sag__profile_name" -v new_profile_name=$sag__new_profile_name '{
            if ($0==replace_flag) {
                print "sag__profile_name=" new_profile_name
            } else {
                print $0
            }
        };' > $sag__config_path.tmp
    rm $sag__config_path
    mv $sag__config_path.tmp $sag__config_path

    echo ""
    echo "===> sag: renamed profile <==="
    echo "Profile renamed from \"$sag__profile_name\" to: \"$sag__new_profile_name\""
}

setflags() {
    sag__new_flags=$@
    sag__current_profile_raw=$(cat $sag__config_path | grep -A 4 "# sag__beacon_tag_current_profile BEGIN")
    sag__profile_name=$(echo "$sag__current_profile_raw" | grep "sag__profile_name=" | sed -e "s/sag__profile_name=//")

    if [[ "$sag__profile_name" == "no_profile" ]]; then
        echo ""
        echo "===> Preset flags are disabled for \"no_profile\"!"
        echo "First switch to a profile before setting preset flags:"
        echo "    sag -sp PROFILE_NAME"
        return 1
    fi

    sag__profile_preset_directory=$(echo "$sag__current_profile_raw" | grep "sag__profile_preset_directory" | sed -e "s/sag__profile_preset_directory=//")

    cat $sag__config_path | awk -v replace_flag="sag__profile_name=$sag__profile_name" -v new_profile_preset_flags="$sag__new_flags" -v profile_preset_directory="$sag__profile_preset_directory" 'BEGIN {do_replace=0};
        {
            if ($0==replace_flag) {
                do_replace=1;
            } else if ($0=="#"){
                do_replace=0;
            }

            if (do_replace==1 && $0==replace_flag) {
                print replace_flag
                print "sag__profile_preset_flags=\"" new_profile_preset_flags "\"";
                print "sag__profile_preset_directory=" profile_preset_directory;
            } else if (do_replace==0) {
                print $0
            }
        };' > $sag__config_path.tmp
    rm $sag__config_path
    mv $sag__config_path.tmp $sag__config_path

    echo ""
    echo "===> sag: set flags <==="
    echo "Preset flags for profile \"$sag__profile_name\" now set to: $sag__new_flags"
}

setdirectory() {
    sag__new_directories=$@
    for sag__new_directory in $sag__new_directories
    do
        if [[ ! -d "$sag__new_directory" ]]; then
            echo ""
            echo "===> Invalid directory path: $sag__new_directory does not exist!"
            return 1
        fi
    done

    sag__current_profile_raw=$(cat $sag__config_path | grep -A 4 "# sag__beacon_tag_current_profile BEGIN")
    sag__profile_name=$(echo "$sag__current_profile_raw" | grep "sag__profile_name=" | sed -e "s/sag__profile_name=//")

    if [[ "$sag__profile_name" == "no_profile" ]]; then
        echo ""
        echo "===> Preset directories are disabled for \"no_profile\"!"
        echo "First switch to a profile before setting preset directories:"
        echo "    sag -sp PROFILE_NAME"
        return 1
    fi

    sag__profile_preset_flags=$(echo "$sag__current_profile_raw" | grep "sag__profile_preset_flags" | sed -e "s/sag__profile_preset_flags=//")

    cat $sag__config_path | awk -v replace_flag="sag__profile_name=$sag__profile_name" -v profile_preset_flags="$sag__profile_preset_flags" -v new_profile_preset_directories="$sag__new_directories" 'BEGIN {do_replace=0};
        {
            if ($0==replace_flag) {
                do_replace=1;
            } else if ($0=="#"){
                do_replace=0;
            }

            if (do_replace==1 && $0==replace_flag) {
                print replace_flag
                print "sag__profile_preset_flags=" profile_preset_flags;
                print "sag__profile_preset_directory=\"" new_profile_preset_directories "\"";
            } else if (do_replace==0) {
                print $0
            }
        };' > $sag__config_path.tmp
    rm $sag__config_path
    mv $sag__config_path.tmp $sag__config_path

    echo ""
    echo "===> sag: set directory(s) <==="
    echo "Preset directory(s) for profile \"$sag__profile_name\" now set to: \"$sag__new_directories\""
}

addnewprofile() {
    sag__add_profile_name=$1
    if [[ -z "$sag__add_profile_name" ]]; then
        echo ""
        echo "===> Must specify a name when adding a new profile!"
        return 1
    elif [[ "$sag__add_profile_name" == "no_profile" ]]; then
        echo ""
        echo "===> Must not add new profile with name \"no_profile\"!"
        return 1
    fi

    cat $sag__config_path | awk -v add_profile_name=$sag__add_profile_name '{
            if ($0=="# sag__beacon_tag_new_profiles") {
                print "sag__profile_name=" add_profile_name
                print "sag__profile_preset_flags=\"\""
                print "sag__profile_preset_directory=\"\""
                print "#"
                print "# sag__beacon_tag_new_profiles"
            } else {
                print $0
            }
        };' > $sag__config_path.tmp
    rm $sag__config_path
    mv $sag__config_path.tmp $sag__config_path

    echo ""
    echo "===> sag: added new profile <==="
    echo "New Profile: $sag__add_profile_name"
}

listprofiles() {
    echo ""
    echo "===> sag: list profiles <==="
    echo "The following profiles are available for use:"
    cat $sag__config_path | awk 'BEGIN {do_print=0};
        {
            if ($0=="# sag__beacon_tag_profiles") {
                do_print=1
            } else if ($0=="# sag__beacon_tag_new_profiles") {
                do_print=0
            }

            if (do_print==1) {
                if ($1=="#") {
                    if ($2=="") {
                        print " "
                    }
                } else {
                    print $0
                }
            }
        };'

}

# =============================================
# ================ Script Main ================
# =============================================

sag__config_path=~/.sagrc
sag__file_name="                                              "
sag__option=$1
sag__default_tool=rg
sag__color_param='--smart-case --line-number --color always'

if [[ -z "$sag__option" || "$sag__option" == "-h" || "$sag__option" == "--help" || "$sag__option" == "--info" ]]; then
    . $sag__config_path
    print_help
    echo ""
    exit 0
elif [[ "$sag__option" == "-wp" || "$sag__option" == "--whichprofile" ]]; then
    . $sag__config_path
    print_current_profile_info
    echo ""
    exit 0
elif [[ "$sag__option" == "-sp" || "$sag__option" == "--switchprofile" ]]; then
    switchprofile $2
    echo ""
    exit 0
elif [[ "$sag__option" == "-rp" || "$sag__option" == "--renameprofile" ]]; then
    renameprofile $2
    echo ""
    exit 0
elif [[ "$sag__option" == "-sf" || "$sag__option" == "--setflags" ]]; then
    shift
    setflags $@
    echo ""
    exit 0
elif [[ "$sag__option" == "-sd" || "$sag__option" == "--setdirectory" ]]; then
    shift
    setdirectory $@
    echo ""
    exit 0
elif [[ "$sag__option" == "-anp" || "$sag__option" == "--addnewprofile" ]]; then
    addnewprofile $2
    echo ""
    exit 0
elif [[ "$sag__option" == "-lp" || "$sag__option" == "--listprofiles" ]]; then
    listprofiles
    exit 0
fi

. $sag__config_path

if [[ "$sag__profile_name" == "no_profile" ]]; then
    # Add pwd as the last arg so output file names are absolute, usable across shells
    sag__flags=""
    sag__cwd=$(pwd)
else
    sag__flags=$sag__profile_preset_flags
    sag__cwd="$sag__profile_preset_directory"
    sag__cwd=$(eval "echo $sag__cwd")
fi

echo ""
echo "===> Current Profile: $sag__profile_name"
echo "===> Command: $sag__default_tool $sag__color_param $sag__flags"
echo "===> Searching under: $sag__cwd"
echo "===> Searching for: $@"

$sag__default_tool $sag__color_param $sag__profile_preset_flags "$@" "$sag__cwd" | tee >$sag__dev_null >(display_shortcuts) >(process_shorcut_paths | remove_escaped_chars > $sag__shortcut_file)

if [ $sag__default_editor == 'vim' -o $sag__default_editor == 'gvim' ]; then
    create_shortcut_cmd_vim
else
    echo "Error: unsupported default editor specified in sag__default_editor"
fi
